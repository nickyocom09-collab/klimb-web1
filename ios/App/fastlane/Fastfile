# Klimb — build the web app, sync it into iOS, and ship to TestFlight in one
# command:  bundle exec fastlane beta
#
# Requires an App Store Connect API key. Copy fastlane/.env.example to
# fastlane/.env (gitignored) and fill in your key details before running.

default_platform(:ios)

APP_IDENTIFIER = "com.nickyocom.klimb"
XCODEPROJ = "Klimb.xcodeproj"
SCHEME = "Klimb"
TEAM_ID = "6Z9QZ8CXJ6"
APP_STORE_PROFILE = "Klimb App Store Push 2026-08-01"
# Repo root (klimb-web) — four levels up from this Fastfile.
REPO_ROOT = File.expand_path("../../../..", __FILE__)

# App Store Connect occasionally returns a temporary 5xx response even when
# the API key and request are valid. Retry only those server-side failures;
# credential, configuration, and validation errors still fail immediately.
def with_app_store_retry(label, max_attempts: 4)
  attempt = 1
  begin
    yield
  rescue => error
    transient_server_error = error.message.match?(
      /server error got 5\d\d|status(?: code)?[=: ]+5\d\d|service unavailable|temporarily unavailable/i
    )
    raise unless transient_server_error && attempt < max_attempts

    wait_seconds = attempt * 10
    UI.important(
      "Apple returned a temporary server error during #{label}. " \
      "Retrying in #{wait_seconds}s (attempt #{attempt + 1}/#{max_attempts})..."
    )
    sleep(wait_seconds)
    attempt += 1
    retry
  end
end

platform :ios do
  desc "Build the web app, sync Capacitor, and upload a new build to TestFlight"
  lane :beta do
    # App Store Connect API key — read from fastlane/.env (see .env.example).
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
      in_house: false,
    )

    # Keep the APNs-enabled signing profile available on headless build hosts.
    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      provisioning_name: APP_STORE_PROFILE,
      ignore_profiles_with_different_name: true,
      readonly: true,
      output_path: "build/profiles",
    )

    # 1) Build the web bundle and copy it into the native iOS project.
    # Capacitor still looks for its default App.xcodeproj name when syncing
    # Swift Package Manager plugins. The project was renamed to Klimb.xcodeproj,
    # so provide a temporary compatibility link while sync runs.
    compatibility_project = File.join(REPO_ROOT, "ios/App/App.xcodeproj")
    created_compatibility_project = false
    unless File.exist?(compatibility_project) || File.symlink?(compatibility_project)
      File.symlink("Klimb.xcodeproj", compatibility_project)
      created_compatibility_project = true
    end

    begin
      # NODE_BIN can point Fastlane at a known-good Node release when a newly
      # installed global Node version is incompatible with the TypeScript build.
      node_bin = ENV.fetch("NODE_BIN", "node")
      node_directory = File.dirname(node_bin)
      node_path = "PATH='#{node_directory}':$PATH"
      if ENV["SKIP_WEB_BUILD"] == "1"
        UI.important("Skipping the web build and syncing the existing dist bundle.")
        sh("cd '#{REPO_ROOT}' && #{node_path} npx cap sync ios")
      else
        sh("cd '#{REPO_ROOT}' && #{node_path} npm run build && npx cap sync ios")
      end
    ensure
      File.unlink(compatibility_project) if created_compatibility_project
    end

    # 2) Bump the build number to one past whatever TestFlight already has,
    #    so every upload is unique without you tracking numbers by hand.
    latest = with_app_store_retry("the TestFlight build-number check") do
      latest_testflight_build_number(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        initial_build_number: 0,
      )
    end
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: latest + 1,
    )

    # 3) Archive and sign the app for the App Store. Use the explicit App Store
    #    profile generated after enabling Push Notifications; otherwise a
    #    headless Xcode build can select the older profile that lacks APNs.
    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          APP_IDENTIFIER => APP_STORE_PROFILE,
        },
      },
    )

    # 4) Upload to TestFlight. Doesn't wait for Apple's processing — the build
    #    shows up in the TestFlight tab a few minutes later.
    with_app_store_retry("the TestFlight upload") do
      upload_to_testflight(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        skip_waiting_for_build_processing: true,
      )
    end

    UI.success("Uploaded build #{latest + 1} to TestFlight 🚀")
  end
end
